...
name: Java CD

on:
  repository_dispatch:
    types:
      - deploy

  workflow_dispatch:

permissions:
  contents: read

jobs:
  deploy:
    name: Deploy to Docker Desktop Kubernetes
    runs-on: self-hosted

    steps:

      # 1. Checkout Kubernetes files
      - name: Checkout deployment repository
        uses: actions/checkout@v4

      # 2. Check Kubernetes
      - name: Check Kubernetes
        run: |
          kubectl get nodes

      # 3. Apply all Kubernetes files
      - name: Apply Kubernetes manifests
        run: |
          kubectl apply -f k8s/

      # 4. Update Java application image
      - name: Update Java application image
        run: |
          kubectl set image deployment/java-app \
            java-app=${{ github.event.client_payload.image }} \
            -n java-demo

      # 5. Wait for Java deployment
      - name: Wait for Java deployment
        run: |
          kubectl rollout status deployment/java-app \
            -n java-demo \
            --timeout=180s

      # 6. Show pods
      - name: Check pods
        run: |
          kubectl get pods -n java-demo

      # 7. Show services
      - name: Check services
        run: |
          kubectl get services -n java-demo